server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12m;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /uploads/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }
    location = /sitemap.xml { proxy_pass ${API_UPSTREAM}; }
    location = /robots.txt { proxy_pass ${API_UPSTREAM}; }
    location = /health { proxy_pass ${API_UPSTREAM}; }

    location /assets/ {
        try_files $uri =404;
        # Only Vite's content-hashed bundles can be cached indefinitely.
        location ~ ^/assets/.+-[A-Za-z0-9_-]+\.(js|css)$ {
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
