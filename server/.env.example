NODE_ENV=development
PORT=4000

# Local: mongodb://127.0.0.1:27017/timeglobaltech
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/timeglobaltech
MONGODB_URI=mongodb://127.0.0.1:27017/timeglobaltech

# Generate each with: openssl rand -base64 48   (MUST be different values)
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-byte-random-string

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated. Vite site + admin SPA.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

SEED_ADMIN_EMAIL=admin@timeglobaltech.com
# Leave unset to have `npm run seed` generate a strong one and print it once.
# SEED_ADMIN_PASSWORD=

# ── Media storage ────────────────────────────────────────────
# `local` writes to ./uploads and works with no extra setup.
# Switch to `cloudinary` once CLOUDINARY_* are set (driver is a stub — see lib/storage.ts).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:4000
MAX_UPLOAD_MB=10

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── SMTP (new-inquiry alert email) ───────────────────────────
# Optional. The admin Settings → SMTP screen takes precedence; these are the
# fallback so a fresh deploy can still send. For Gmail, use an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM=you@gmail.com
# SMTP_FROM_NAME=Time Global Tech
# LEAD_NOTIFY_TO=inbox@yourdomain.com
